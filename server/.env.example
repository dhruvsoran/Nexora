# Server configuration
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# MongoDB (Atlas connection string)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/nexora?retryWrites=true&w=majority

# Redis (cloud: Upstash/Redis Cloud). Use rediss:// for TLS; Upstash db.redis.io also requires TLS.
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=nexora:

# JWT
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECURE=false

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini
GEMINI_API_KEY=

# Agora (Conversational AI voice assistant)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# Agent LLM prompt (used when starting a voice conversation)
AGORA_AI_PROMPT=You are Nexora AI, a helpful project-management assistant.

# Session cookie signing
SESSION_SECRET=CHANGE_ME_SESSION

# Optional: enforce a max attachment size (bytes)
MAX_UPLOAD_BYTES=5242880

# Email invitations (SMTP)
# Host you got from your mail provider. Leave empty to disable sending (invite links are shown in-app instead).
SMTP_HOST=
# 465 for SSL, 587 for STARTTLS
SMTP_PORT=587
# 'true' when SMTP_PORT=465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nexora <noreply@yourdomain.com>"

# Frontend URL used to build invite links (must match where the app is hosted)
CLIENT_URL=http://localhost:5173
