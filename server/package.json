  "private": true,
  "description": "Nexora API — Express + Socket.IO + MongoDB + Redis",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc -p tsconfig.json",
